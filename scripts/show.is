import std::String;
import std::option;
import std::io;

use string_consume_fn = fn(int, String): Option<String>;

use fibbnacci = fn(x: uint): uint =>
    if x == 1 || x == 2 {1}
    else { fibbnacci(x - 1) + fibbnacci(x - 2) };

int main() {
    println(fibbnacci(10)); // 55
    return 0;
}
use ConvertorFnCollection = fn(int, float): str*`[12];