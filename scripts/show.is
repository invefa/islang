import std::string;
import std::option;
import std::io;

use string_consume_fn = fn(int, String):Option<String>;

use fibbnacci = fn(uint x):uint { if x == 1 {1} else if x == 2 {1} else { fibbnacci(x - 1) + fibbnacci(x - 2) } };

int main() {
    println(fibbnacci(10)); // 55
    return 0;
}
use ConvertorFnCollection = fn(int,float):str*`[12];