import std::String;
import std::Option;
import std::io;

use StringConsumeFn       = fn(int,String):Option<String>;
use ConvertorFnCollection = fn(int,float):str*`[12];

use fib =
    fn(x: u32): u32 =>
        if x <= 2 {1}
        else {fib(x-1)+fib(x-2)};

fn main(): i32 {
    println(fib(10)); // 55
    return 0;
}