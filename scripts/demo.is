import std.utils::Option;
import std.io::println;

int main(){
    use Option::[Some,None];

    let list = [1, 3, 6, 7, 9, 11, 123, 232, 947];
    let matrix: i32[3;3] = [
        [1 , 3 , 0 ],
        [7 , 23, 11],
        [12, 32, 55],
    ];
    let nested_matrix: i32[3]*[3] = [
        &[1, 2, 3],
        &[4, 5, 6],
        &[7, 8, 9],
    ];

    assert(i32[3;3] == i32[3][3]);
    assert(i32[3;3] != i32[3]*[3]);

    form deref<n: std::compent::name> => n!;
    form enref<n: std::compent::name> => @n;

    use std::compent::name as std::name in {
        form nse!<name: std::name<dst=:Typed>, T?: typeof<name!>> => use @name = let:T=name;
        form nse!<name: std::name, etc: std::name...> {
            nse!<name>;
            use <fst, etc...> = etc in
            nse!<fst, ...etc>;
        };
    }

    use i32[]*`[isize] = form<ap: i32[]*, i: isize> => do nse! ap in ap^*[i];
    form (i32[]*`[isize])<ap, i> => do nse! ap in ap^*[i];

    use *String = form<str: String> => str.as_str();
    form (*String)<str> => str.as_str();

    use String + String = form<s1: String, s2: String> => do nse! s1 s2 in s1.clone().append(s2);
    form (String + String)<s1, s2> => do nse! s1 s2 in s1.clone().append(s2);
    // operator[]<ap: i32[]*, i: isize> => (*ap)[i];

    nested_matrix[1]^*[2]->println(); // 6
    nested_matrix[1][2]->println();   // 6
    println(*<nested_matrix[1]>[2]);  // 6
    println(*(nested_matrix[1])[2]);  // 6


    struct A {
        let {
            a: i32 = 0,
            b: str = "unk",
            c: f32 = 0f,
        }
    }

    use sqrt2 = let:f64=sqrt(2);

    let concurrent_map: Hashmap<str,i32>^RwLock^Arc = Hashmap<int,str>::new()->RwLock::new()->Arc::new();
    let concurrent_map: Arc<RwLock<Hashmap<str, i32>>> = Arc::new(RwLock::new(Hashmap<int,str>::new()));

    form typeof<val!: T, T?: type> => T;

    assert(typeof 123 == typeof(123) && typeof(123) == typeof<123>);
    let i: 123^typeof = 123;

    let a: str^Option^Cell = "some"->Option::make()->Cell::make();
    let a: Cell<Option<str>> = Cell::make(Option::make("some"));

    use std::compent::{name, scope}, std::Iterable in
    form foreach<tail_pat: patt<a: name, b: Iterable, s: a^scope>{(a: b) s}> {
        for tail_pat.a in tail_pat.b {tail_pat.s}
    }

    ValType<a>`->jailbreak();
    do foreach(a: list) {
        a->str->println();
    };

    fn string(some: A): str {
        some.str
    }

    let found1 =
        let result = 0 in
        for num in list {
            if (num % 2 == 0) break Some(num);
            else if (num % 17 == 0) break None;
            else result += num;
        } else Some(result);

    /**
     * 'done means an identifer `done` instead of the keyword `done`.
     * This feature applies to all keywords, but when it is applied to
     * ordinary identifiers, it will have a completely different meaning.
     */
    use 'done = 1;
    let i = {
        use a = let:int=123;
        const k = 1 in
        for(i in 0..32) a *= a + i * k + 'done;
        // done is a keyword using to emit value of block-expression instantly.
        if (a < 32767) done a;
        // you can also use a tail expr to emit value.
        a % 10086
    }

    let found2 = for:outer row in matrix {
        let a = for:inner (num in row)
            if (num % 3 == 1) break:outer Some(num);
            else if (num % 3 == 2) continue:outer;
            else if (num % 19 == 5) break num / 2;
            else continue;
        else 0;
        if (a % 23 == 1) break Some(a);
    } else None;

    use test_fn1 = fn(x: int, y: int): int => x + y;
    use test_fn2 = fn(x: int, y: int): int {x + y};
    use test_fn3 = fn(x, y): int => x + y;  // unconducted fn there
    use test_fn4 = fn(x, y) => x + y;       // unconducted fn there
    use test_fn5_type = fn(int, int): int;
    use test_fn5_protocol1 = fn(x: int, y: int): int;
    use test_fn5_protocol2 = test_fn5_type(x, y);
    use test_fn5_protocol3 = fn(int, int): int` (x, y);
    use test_fn5 = test_fn5_protocol1 {x + y};
    use test_fn6 = test_fn5_protocol2 => x + y;
    use test_fn7 = test_fn5_protocol3 => x + y;
    use test_fn8 = fn:int(int x, int y) => x + y;
    use test_fn8 = fn:int(int x, int y) {x + y};
    println(test_fn1(1, 2));
    println(test_fn2(1, 2));
    println(test_fn3(1, 2)); // conducted fn there
    println(test_fn4(1, 2)); // conducted fn there
    println(test_fn5(1, 2));
    println(test_fn6(1, 2));
    println(test_fn7(1, 2));
    println(test_fn8(1, 2));

    use std::'type::is::[Intger, String] in {
        /* form<x: int, y: int>: expr<int> */
        use test_form1_1 = form<x: int, y: int>:int {x + y};
        use test_form1_2 = form<x: int, y: int> {x + y};
        use test_form1_3 = form<x: int, y: int> x + y;

        /* form<x: Integer, y: String>: std::compent::expr::arith_expr<str> */
        use test_form2_1 = form<x: type, y: type> where x: Integer, y: String {let:x=6->str + let:y="=lord"};
        use test_form2_2 = form<x: type, y: type> where x: Integer, y: String => let:x=6->str + let:y="=lord";
        use test_form2_3 = form<x: type, y: type> where x: Integer, y: String` let:x=6->str + let:y="=lord";
        use test_form2_4 = form<x: Integer, y: String>: str => let:x=6->str + let:y="=lord";
        use test_form3_1 = form<x: type, y: type> where x: Integer, y: String => const{let:x=6->str + let:y="=lord"};

        /* form<x: Integer, y: String>: std::compent::expr::scope_expr<str> */
        use test_form3_1 = form<x: type, y: type> where x: Integer, y: String => {let:x=6->str + let:y="=lord"};
        use test_form3_2 = form<x: type, y: type> where x: Integer, y: String => {let:x=6->str + let:y="=lord"};
        use test_form3_3 = form<x: Integer, y: String>: str => {let:x(6)->str + let:y("=lord")};
    }!;

    println(found1.unwrap(), found2.unwrap());

    return 0;
}
